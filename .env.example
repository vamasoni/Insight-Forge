# --- LLM (pick one) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Mistral:   LLM_PROVIDER=openai  LLM_BASE_URL=https://api.mistral.ai/v1  LLM_MODEL=mistral-small-latest
# Anthropic: LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-4-5
# vLLM:      LLM_PROVIDER=openai  LLM_BASE_URL=http://localhost:8000/v1  LLM_MODEL=<served model name>
LLM_BASE_URL=

# --- Data ---
DB_PATH=data/olist.duckdb

# --- Tracing (optional; falls back to runs/traces.jsonl) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
